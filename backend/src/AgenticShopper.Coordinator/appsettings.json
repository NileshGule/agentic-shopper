{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=agentic_shopper;Username=postgres;Password=postgres;Port=5432"
  },
  "LLM": {
    "Provider": "FoundryLocal",
    "Endpoint": "http://localhost:8080",
    "Model": "phi-3-mini",
    "Timeout": 30
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "receipts"
  },
  "AzureDocumentIntelligence": {
    "Endpoint": "",
    "ApiKey": ""
  },
  "PaddleOCR": {
    "ExecutablePath": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "AgenticShopper:"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "JwtSettings": {
    "SecretKey": "your-secret-key-min-32-characters-long-change-in-production",
    "Issuer": "AgenticShopper.API",
    "Audience": "AgenticShopper.Client",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
