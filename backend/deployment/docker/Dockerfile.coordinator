# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Copy solution and project files
COPY ["AgenticShopper.sln", "./"]
COPY ["src/AgenticShopper.Coordinator/AgenticShopper.Coordinator.csproj", "src/AgenticShopper.Coordinator/"]
COPY ["src/AgenticShopper.Core/AgenticShopper.Core.csproj", "src/AgenticShopper.Core/"]
COPY ["src/AgenticShopper.Data/AgenticShopper.Data.csproj", "src/AgenticShopper.Data/"]
COPY ["src/AgenticShopper.Agents.Receipt/AgenticShopper.Agents.Receipt.csproj", "src/AgenticShopper.Agents.Receipt/"]
COPY ["src/AgenticShopper.Agents.Categorization/AgenticShopper.Agents.Categorization.csproj", "src/AgenticShopper.Agents.Categorization/"]
COPY ["src/AgenticShopper.Agents.Frequency/AgenticShopper.Agents.Frequency.csproj", "src/AgenticShopper.Agents.Frequency/"]
COPY ["src/AgenticShopper.Agents.Budget/AgenticShopper.Agents.Budget.csproj", "src/AgenticShopper.Agents.Budget/"]
COPY ["src/AgenticShopper.Agents.ListGenerator/AgenticShopper.Agents.ListGenerator.csproj", "src/AgenticShopper.Agents.ListGenerator/"]
COPY ["src/AgenticShopper.Agents.PriceComparison/AgenticShopper.Agents.PriceComparison.csproj", "src/AgenticShopper.Agents.PriceComparison/"]

# Restore dependencies
RUN dotnet restore "src/AgenticShopper.Coordinator/AgenticShopper.Coordinator.csproj"

# Copy all source code
COPY . .

# Build and publish
WORKDIR "/src/src/AgenticShopper.Coordinator"
RUN dotnet build "AgenticShopper.Coordinator.csproj" -c Release -o /app/build
RUN dotnet publish "AgenticShopper.Coordinator.csproj" -c Release -o /app/publish /p:UseAppHost=false /p:ErrorOnDuplicatePublishOutputFiles=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

# Install curl for healthcheck, tesseract-ocr for offline receipt processing,
# and poppler-utils (pdftoppm) for PDF-to-image conversion
RUN apk add --no-cache curl tesseract-ocr tesseract-ocr-data-eng poppler-utils

# Copy published application
COPY --from=build /app/publish .

# Ensure tessdata directory exists and has the language data
RUN mkdir -p /app/tessdata && \
    cp /usr/share/tessdata/eng.traineddata /app/tessdata/ 2>/dev/null || true

# Create non-root user
RUN addgroup -g 1000 appuser && adduser -u 1000 -G appuser -s /bin/sh -D appuser
RUN chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 80

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:80/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "AgenticShopper.Coordinator.dll"]
